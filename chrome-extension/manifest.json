{
  "manifest_version": 3,
  "name": "Vimeo to Cloudflare R2 Migrator",
  "version": "1.0.0",
  "description": "Fast edge-to-edge video migration from Vimeo to Cloudflare R2 via Cloudflare Workers.",
  "permissions": [
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.vimeo.com/*",
    "https://api.cloudflare.com/*",
    "https://*.workers.dev/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vimeo → Cloudflare R2 Migrator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
